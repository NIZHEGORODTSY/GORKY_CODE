# Telegram: токен от @BotFather
BOT_TOKEN=

# Postgres. Для docker compose хост — db; локально — localhost
POSTGRES_USER=gorky
POSTGRES_PASSWORD=
POSTGRES_DB=gorky
DATABASE_URL=postgresql+asyncpg://gorky:CHANGE_ME@db:5432/gorky

# GigaChat: "Authorization key" из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
GIGACHAT_EMBEDDINGS_MODEL=Embeddings


# Путь к корневому сертификату Минцифры (НУЦ); пусто — системное хранилище
SBER_CA_BUNDLE=certs/russian_trusted_root_ca.pem

# Голос: распознавание — GigaChat (GIGACHAT_MODEL), озвучка — edge-tts
TTS_VOICE=ru-RU-SvetlanaNeural

DEFAULT_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Mini App (календарь). WEBAPP_URL можно не задавать — соберётся из WEBAPP_DOMAIN как https://<домен>/app/
WEBAPP_URL=
WEBAPP_PORT=8080
# Домен VPS для Caddy (HTTPS Lets Encrypt): свой домен или поддомен (sslip.io в РФ блокируется). Пусто — календаря нет
WEBAPP_DOMAIN=

# Порт базы из Docker на самом сервере (только localhost; для SSH-туннеля)
DB_HOST_PORT=5433

# Прокси только для Telegram, если хостинг его блокирует: socks5://xray:1080 (см. docs/DEPLOY.md)
TELEGRAM_PROXY=

# HTTPS через уже стоящий на сервере nginx вместо своего Caddy (см. docs/DEPLOY.md)
# REVERSE_PROXY=nginx
# Порт веб-сервера бота на localhost сервера
WEBAPP_HOST_PORT=18080
