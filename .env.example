# Telegram: токен от @BotFather
BOT_TOKEN=

# Postgres. Для docker compose хост — db; локально — localhost
POSTGRES_USER=gorky
POSTGRES_PASSWORD=
POSTGRES_DB=gorky
DATABASE_URL=postgresql+asyncpg://gorky:CHANGE_ME@db:5432/gorky

# GigaChat: "Authorization key" из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
GIGACHAT_EMBEDDINGS_MODEL=Embeddings

# SaluteSpeech: "Authorization key" отдельного проекта SaluteSpeech
SALUTE_SPEECH_CREDENTIALS=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS

# Путь к корневому сертификату Минцифры (НУЦ); пусто — системное хранилище
SBER_CA_BUNDLE=certs/russian_trusted_root_ca.pem

DEFAULT_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
